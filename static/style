/* Refined calendar / checklist / notepad layout */
.planner-middle-grid{grid-template-columns:minmax(0,1.12fr) minmax(290px,.88fr);align-items:start}
.planner-right-stack{display:grid;gap:20px;min-width:0}
.planner-bottom-grid{grid-template-columns:1fr}
.calendar-expand-icon{width:36px;height:36px;display:flex;align-items:center;justify-content:center;border:1px solid #e7d8ee;background:#fff;border-radius:11px;color:#765184;cursor:pointer;flex:0 0 36px}
.calendar-expand-icon:hover{background:#f4eafb;border-color:#c9afe0}
.calendar-expand-icon svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.mini-calendar{gap:0;border-left:1px solid #eee3ef;border-top:1px solid #eee3ef;border-radius:12px;overflow:hidden}
.mini-calendar .calendar-weekday{background:#f5edf9;padding:9px 2px;border-right:1px solid #eee3ef;border-bottom:1px solid #eee3ef;color:#765b83;font-weight:700}
.mini-calendar .calendar-day{min-height:54px;border-radius:0;border-right:1px solid #eee3ef;border-bottom:1px solid #eee3ef;background:#fffdfd;justify-content:flex-start;align-items:flex-start;padding:7px 8px;font-size:12px}
.mini-calendar .calendar-day.today{background:#f3e8ff;color:#67457c;box-shadow:inset 0 0 0 1px #c8a8e7}
.mini-calendar .calendar-day.selected{outline:2px solid #9e77b7;outline-offset:-3px;background:#fff0f6}
.mini-calendar .calendar-day.empty-day{background:#fbf8fc}
.mini-calendar .calendar-dots{margin-top:auto;height:7px}
.notes-panel textarea{border-radius:5px;background:repeating-linear-gradient(to bottom,#fffdfb 0,#fffdfb 30px,#d9c9ec 31px,#fffdfb 32px)!important;padding:8px 14px 8px 42px;line-height:32px;position:relative;box-shadow:inset 30px 0 0 #fff3f6,inset 31px 0 0 #edbfd0}
.task-panel,.notes-panel{background:linear-gradient(135deg,#fffdfd,#fff9fc)}
@media(max-width:950px){.planner-middle-grid{grid-template-columns:1fr}.planner-right-stack{grid-template-columns:1fr}.mini-calendar .calendar-day{min-height:43px;padding:6px 4px}}
