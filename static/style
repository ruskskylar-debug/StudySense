  --study-butter-border: #ecdca0;
  --study-butter-ink: #79632a;
}

/* Review choices: a coordinated lavender / butter yellow / pink set */
.result-button.got-it {
  background: var(--study-lavender) !important;
  color: var(--study-lavender-ink) !important;
  border: 1px solid var(--study-lavender-border) !important;
}
.result-button.got-it:hover { background: #e3d1f2 !important; }
.result-button.almost {
  background: var(--study-butter) !important;
  color: var(--study-butter-ink) !important;
  border: 1px solid var(--study-butter-border) !important;
}
.result-button.almost:hover { background: #f5e5ad !important; }
.result-button.need-help {
  background: var(--study-pink) !important;
  color: var(--study-pink-ink) !important;
  border: 1px solid var(--study-pink-border) !important;
}
.result-button.need-help:hover { background: #f2ccdc !important; }
.result-button.selected {
  outline: 2px solid #9b78b2 !important;
  outline-offset: 2px;
  filter: none !important;
}

/* Quick actions use the same warm pastel colors instead of generic gray-green */
.quick-action-card {
  background: #fffaf7 !important;
  border: 1px solid #e9dce9 !important;
  color: #49374f !important;
  box-shadow: 0 2px 8px rgba(89, 55, 95, .045) !important;
  transition: transform .16s ease, border-color .16s ease, background .16s ease;
}
.quick-action-card:nth-child(3n + 1) {
  background: #f0e6f8 !important;
  border-color: #dfcde9 !important;
}
.quick-action-card:nth-child(3n + 2) {
  background: #f9e6ed !important;
  border-color: #efd0dc !important;
}
.quick-action-card:nth-child(3n) {
  background: #fbf0d2 !important;
  border-color: #eee0b2 !important;
}
.quick-action-card h3 { color: #59375f !important; }
.quick-action-card p { color: #756478 !important; }
.quick-action-card:hover {
  transform: translateY(-2px);
  border-color: #c7a8d5 !important;
  box-shadow: 0 5px 13px rgba(89, 55, 95, .07) !important;
}

