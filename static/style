.flashcard-grid{gap:22px}.study-card-container{max-width:100%}.study-card{border-radius:22px;box-shadow:0 8px 20px rgba(83,48,95,.07);border:1px solid #eee2ef}.card-front,.card-back{background:#fffdfb;border:0;padding:30px 25px;min-height:230px}.card-front{background:linear-gradient(155deg,#fffdfb 0%,#fbf6ff 100%)}.card-back{background:linear-gradient(155deg,#fffdfb 0%,#fff4f7 100%)}.card-label{letter-spacing:1.6px;color:#9b7aa8;font-size:10px}.flip-hint{color:#a18da5}.card-result form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.result-button{border-radius:12px!important;border:1px solid transparent!important;padding:11px 7px!important;font-weight:700;transition:transform .15s,filter .15s}.result-button:hover{transform:translateY(-1px);filter:saturate(1.08)}.result-button.got-it{background:#eee3f8!important;color:#67477c!important;border-color:#e0d0ef!important}.result-button.almost{background:#fbefc9!important;color:#78652d!important;border-color:#f0e2ad!important}.result-button.need-help{background:#f8e0e9!important;color:#914e6c!important;border-color:#f0ccdb!important}
