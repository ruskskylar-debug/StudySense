<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Study Planner - StudySense</title><link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}"></head>
<body><div class="app">
<aside class="sidebar"><div class="logo"><h1>StudySense</h1><p>Your personal study space</p></div><nav>
        <a href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-7h6v7"/></svg>Home</a>
        <a href="/planner" class="active"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M7 14h3M7 17h6"/></svg>Study Planner</a>
        <a href="/ask-ai"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v13H9l-5 4zM8 8h8M8 12h5"/></svg>Ask AI</a>
        <a href="/flashcards"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>Flashcards</a>
        <a href="/progress"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18M7 15l4-4 3 2 6-7"/></svg>Progress</a>
    </nav></aside>
<main class="main-content planner-main"><div class="page-header"><h2>Your study planner</h2><p>A little plan, a little progress, one day at a time.</p></div>
<section class="planner-top-grid">
<div class="planner-panel weekly-goal-panel"><div class="planner-panel-heading"><span class="planner-icon lavender"><svg viewBox="0 0 24 24"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8m7.2 7.2 2.8 2.8m0-12.8-2.8 2.8m-7.2 7.2-2.8 2.8"/><circle cx="12" cy="12" r="5"/></svg></span><div><h3>Weekly study goal</h3><p>Build a routine that works for you.</p></div></div><div class="goal-number"><strong id="weekMinutes">{{ weekMinutes }}</strong><span>of</span><input id="weeklyGoal" type="number" min="15" max="3000" step="15" value="{{ weeklyGoal }}" aria-label="Weekly study goal in minutes"><span>minutes</span></div><div class="goal-track"><div id="goalFill" style="width:{{ goalPercent }}%"></div></div><div class="goal-foot"><span id="goalPercent">{{ goalPercent }}% of your goal</span><span>Change goal anytime</span></div></div>
<div class="planner-panel"><div class="planner-panel-heading"><span class="planner-icon pink"><svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h16M7 15l4-4 3 2 5-7"/></svg></span><div><h3>Subject progress</h3><p>Reviewed cards across your subjects.</p></div></div>
{% if subjectProgress %}<div class="subject-progress-list">{% for item in subjectProgress %}<div class="subject-progress-row"><div><span>{{ item.name }}</span><small>{{ item.reviewed }}{% if item.total %} / {{ item.total }}{% endif %} cards</small></div><strong>{{ item.percent }}%</strong><div class="subject-track"><span style="width:{{ item.percent }}%;background:{{ ['#c8b0ed','#efb8cf','#f0d681','#b7d3c0'][loop.index0 % 4] }}"></span></div></div>{% endfor %}</div>{% else %}<p class="planner-empty">Your subject progress will appear once you have flashcards to review.</p>{% endif %}</div>
</section>
<section class="planner-middle-grid">
<div class="planner-panel calendar-panel"><div class="planner-panel-heading calendar-heading"><div><h3>Study calendar</h3><p>Keep track of study days, assignments, and tests.</p></div><button class="calendar-expand-icon" type="button" onclick="openCalendar()" aria-label="Expand calendar" title="Expand calendar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M3 3l7 7M16 3h5v5m0-5-7 7M3 16v5h5m-5 0 7-7m11 2v5h-5m5 0-7-7"/></svg></button></div><div class="calendar-controls"><button type="button" onclick="changeMonth(-1)" aria-label="Previous month">‹</button><strong id="monthLabel"></strong><button type="button" onclick="changeMonth(1)" aria-label="Next month">›</button></div><div class="mini-calendar" id="miniCalendar"></div><div class="calendar-legend"><span><i class="event-dot study"></i>Study</span><span><i class="event-dot test"></i>Test</span><span><i class="event-dot assignment"></i>Assignment</span></div>
<div class="event-form"><h4>Add to calendar</h4><div class="event-inputs"><input id="eventTitle" placeholder="Event name" maxlength="180"><input id="eventDate" type="date" aria-label="Event date"><select id="eventKind" aria-label="Event type"><option value="study">Study session</option><option value="test">Test / exam</option><option value="assignment">Assignment</option><option value="other">Other</option></select><button type="button" class="pastel-primary" onclick="addEvent()">Add event</button></div></div><div id="upcomingEvents" class="upcoming-events"></div></div>
<div class="planner-right-stack"><div class="planner-panel task-panel"><div class="planner-panel-heading"><span class="planner-icon yellow"><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/><rect x="3" y="3" width="18" height="18" rx="3"/></svg></span><div><h3>My task list</h3><p>Small steps count, too.</p></div></div><form class="task-add-form" onsubmit="addTask(event)"><input id="taskTitle" placeholder="Add a task to work on..." maxlength="180" required><input id="taskDate" type="date" aria-label="Task due date"><button type="submit" class="pastel-primary">Add</button></form><div id="taskList" class="task-list"></div></div>
<div class="planner-panel notes-panel"><div class="planner-panel-heading"><span class="planner-icon pink"><svg viewBox="0 0 24 24"><path d="M14 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8zM14 3v5h5M7 13h10M7 17h7"/></svg></span><div><h3>Study notes</h3><p>Keep reminders, plans, or thoughts in one place.</p></div></div><textarea id="plannerNotes" placeholder="Write your notes here...">{{ planner.notes }}</textarea><div class="notes-footer"><span id="notesStatus">Saved automatically</span><span>Private to this StudySense project</span></div></div></div>
</section>
</main></div>
<div class="calendar-modal" id="calendarModal" aria-hidden="true"><div class="calendar-modal-card"><div class="calendar-modal-heading"><div><h2>Study calendar</h2><p>Click a date to see what's planned.</p></div><button type="button" onclick="closeCalendar()" aria-label="Close calendar">×</button></div><div class="calendar-controls"><button type="button" onclick="changeMonth(-1,true)" aria-label="Previous month">‹</button><strong id="largeMonthLabel"></strong><button type="button" onclick="changeMonth(1,true)" aria-label="Next month">›</button></div><div class="large-calendar" id="largeCalendar"></div><div id="selectedDateEvents" class="selected-date-events"></div></div></div>
<script>
const initialEvents={{ planner.events|tojson }}; const initialTasks={{ planner.tasks|tojson }}; let events=initialEvents, tasks=initialTasks; let shownDate=new Date(); let selectedDate=''; let notesTimer;
const $=id=>document.getElementById(id); const pad=n=>String(n).padStart(2,'0'); const dateKey=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
async function savePayload(payload){const r=await fetch('/planner/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error('Save failed ('+r.status+')');const result=await r.json();if(!result.success)throw new Error('The planner could not save this change.');return result}
function eventColor(kind){return {study:'study',test:'test',assignment:'assignment',other:'other'}[kind]||'other'}
function renderCalendar(){const year=shownDate.getFullYear(),month=shownDate.getMonth(), label=shownDate.toLocaleDateString(undefined,{month:'long',year:'numeric'});$('monthLabel').textContent=label;$('largeMonthLabel').textContent=label;['miniCalendar','largeCalendar'].forEach(id=>{const box=$(id);box.innerHTML='';['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].forEach(d=>{const el=document.createElement('div');el.className='calendar-weekday';el.textContent=d;box.appendChild(el)});const first=new Date(year,month,1);const offset=(first.getDay()+6)%7;const days=new Date(year,month+1,0).getDate();for(let i=0;i<offset;i++){const blank=document.createElement('div');blank.className='calendar-day empty-day';box.appendChild(blank)}for(let day=1;day<=days;day++){const d=new Date(year,month,day),key=dateKey(d), dayEvents=events.filter(e=>e.date===key);const cell=document.createElement('button');cell.type='button';cell.className='calendar-day'+(key===dateKey(new Date())?' today':'')+(key===selectedDate?' selected':'');cell.innerHTML='<span>'+day+'</span><span class="calendar-dots">'+dayEvents.slice(0,3).map(e=>'<i class="event-dot '+eventColor(e.kind)+'"></i>').join('')+'</span>';cell.onclick=()=>selectDate(key);box.appendChild(cell)}});renderUpcoming();if(selectedDate)renderSelectedDate()}
function changeMonth(delta,large=false){shownDate=new Date(shownDate.getFullYear(),shownDate.getMonth()+delta,1);renderCalendar()}
function openCalendar(){ $('calendarModal').classList.add('open');$('calendarModal').setAttribute('aria-hidden','false');renderCalendar() }function closeCalendar(){$('calendarModal').classList.remove('open');$('calendarModal').setAttribute('aria-hidden','true')}
function selectDate(key){selectedDate=key;renderCalendar();if($('calendarModal').classList.contains('open'))renderSelectedDate();$('eventDate').value=key}
function renderUpcoming(){const box=$('upcomingEvents'),today=dateKey(new Date());const next=events.filter(e=>e.date>=today).sort((a,b)=>a.date.localeCompare(b.date)).slice(0,4);box.innerHTML='<h4>Upcoming</h4>'+ (next.length?next.map(e=>'<div class="upcoming-event"><i class="event-dot '+eventColor(e.kind)+'"></i><span><strong>'+esc(e.title)+'</strong><small>'+e.date+' · '+labelKind(e.kind)+'</small></span><button type="button" aria-label="Delete '+esc(e.title)+'" onclick="deleteEvent(\''+e.id+'\')">×</button></div>').join(''):'<p class="planner-empty">No upcoming events yet. Add a study session or test above.</p>')}
function renderSelectedDate(){const list=events.filter(e=>e.date===selectedDate);$('selectedDateEvents').innerHTML='<h3>'+selectedDate+'</h3>'+(list.length?list.map(e=>'<div class="upcoming-event"><i class="event-dot '+eventColor(e.kind)+'"></i><span><strong>'+esc(e.title)+'</strong><small>'+labelKind(e.kind)+'</small></span><button type="button" onclick="deleteEvent(\''+e.id+'\')">×</button></div>').join(''):'<p>No events for this date.</p>')}
function labelKind(k){return {study:'Study session',test:'Test / exam',assignment:'Assignment',other:'Other'}[k]||'Other'}function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
async function addEvent(){const title=$('eventTitle').value.trim(),date=$('eventDate').value,kind=$('eventKind').value;if(!title||!date){alert('Add an event name and date first.');return}try{const r=await savePayload({action:'add_event',title,date,kind});events=r.planner.events;$('eventTitle').value='';selectedDate=date;shownDate=new Date(date+'T12:00:00');renderCalendar()}catch(error){alert('Could not add the calendar event. Check that StudySense is running, then try again.');console.error(error)}}
async function deleteEvent(id){const r=await savePayload({action:'delete_event',id});events=r.planner.events;renderCalendar()}
function renderTasks(){const box=$('taskList');box.innerHTML=tasks.length?tasks.map(t=>'<div class="task-row '+(t.done?'task-done':'')+'"><label><input type="checkbox" '+(t.done?'checked':'')+' onchange="toggleTask(\''+t.id+'\')"><span>'+esc(t.title)+(t.dueDate?'<small>Due '+esc(t.dueDate)+'</small>':'')+'</span></label><button type="button" aria-label="Delete task" onclick="deleteTask(\''+t.id+'\')">×</button></div>').join(''):'<p class="planner-empty">Your list is clear. Add a task when ready.</p>'}
async function addTask(e){e.preventDefault();const title=$('taskTitle').value.trim();if(!title)return;try{const r=await savePayload({action:'add_task',title,dueDate:$('taskDate').value});tasks=r.planner.tasks;$('taskTitle').value='';$('taskDate').value='';renderTasks()}catch(error){alert('Could not add the task. Check that StudySense is running, then try again.');console.error(error)}}
async function toggleTask(id){const r=await savePayload({action:'toggle_task',id});tasks=r.planner.tasks;renderTasks()}async function deleteTask(id){const r=await savePayload({action:'delete_task',id});tasks=r.planner.tasks;renderTasks()}
$('plannerNotes').addEventListener('input',()=>{ $('notesStatus').textContent='Saving…';clearTimeout(notesTimer);notesTimer=setTimeout(async()=>{await savePayload({notes:$('plannerNotes').value});$('notesStatus').textContent='Saved automatically'},500)});
$('weeklyGoal').addEventListener('change',async()=>{const val=Math.max(15,Math.min(3000,Number($('weeklyGoal').value)||240));$('weeklyGoal').value=val;await savePayload({weeklyGoalMinutes:val});const pct=Math.min(100,Math.round(Number($('weekMinutes').textContent)/val*100));$('goalFill').style.width=pct+'%';$('goalPercent').textContent=pct+'% of your goal'});
renderCalendar();renderTasks();if(!events.length)$('eventDate').value=dateKey(new Date());document.addEventListener('keydown',e=>{if(e.key==='Escape')closeCalendar()});$('calendarModal').addEventListener('click',e=>{if(e.target===$('calendarModal'))closeCalendar()});
</script></body></html>
