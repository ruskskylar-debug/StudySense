<!DOCTYPE html>

<html>

<head>


<title>
    {{ material["fileName"] }} - StudySense
</title>

<link
    rel="stylesheet"
    href="{{ url_for('static', filename='style.css') }}"
>


</head>

<body>

<div class="app">


<aside class="sidebar">


    <div class="logo">

        <h1>
            StudySense
        </h1>

        <p>
            Your personal study space
        </p>

    </div>


    <nav>
        <a href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-7h6v7"/></svg>Home</a>
        <a href="/planner"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M7 14h3M7 17h6"/></svg>Study Planner</a>
        <a href="/ask-ai"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v13H9l-5 4zM8 8h8M8 12h5"/></svg>Ask AI</a>
        <a href="/flashcards"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>Flashcards</a>
        <a href="/progress"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18M7 15l4-4 3 2 6-7"/></svg>Progress</a>
    </nav>


</aside>



<main class="main-content">


    <a
        href="/"
        class="secondary-button"
    >
        Back to Home
    </a>



    <div class="page-header">

        <h2>
            {{ material["fileName"] }}
        </h2>

        <p>
            {{ subject }} · {{ material["topic"] }}
        </p>

    </div>



    <section class="material-view-card">


        <div class="section-header">

            <h2>
                Study Material
            </h2>

            <p>
                This is the information StudySense saved from this material.
            </p>

        </div>



        <div class="material-content">
            {{ material["text"] }}
        </div>


    </section>


</main>


</div>

</body>

</html>
