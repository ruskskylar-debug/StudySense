<!DOCTYPE html>
<html>

<head>
    <title>Ask AI - StudySense</title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='style.css') }}"
    >
</head>

<body>

<div class="app">

    <aside class="sidebar">

        <div class="logo">

            <h1>StudySense</h1>

            <p>Your personal study space</p>

        </div>

        <nav>
        <a href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-7h6v7"/></svg>Home</a>
        <a href="/planner"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18M7 14h3M7 17h6"/></svg>Study Planner</a>
        <a href="/ask-ai" class="active"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v13H9l-5 4zM8 8h8M8 12h5"/></svg>Ask AI</a>
        <a href="/flashcards"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>Flashcards</a>
        <a href="/progress"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18M7 15l4-4 3 2 6-7"/></svg>Progress</a>
    </nav>

    </aside>


    <main class="main-content">

        <div class="page-header">

            <h2>Ask StudySense</h2>

            <p>
                Choose a subject and ask a question about your
                study material.
            </p>

        </div>


        <section class="upload-card">

            <div class="section-header">

                <h2>Ask a Question</h2>

                <p>
                    StudySense will answer using your study material.
                </p>

            </div>


            <form
                action="/ask-ai"
                method="POST"
            >

                <div class="form-group">

                    <label for="subject">
                        Subject
                    </label>

                    <select
                        id="subject"
                        name="subject"
                        required
                    >

                        <option value="">
                            Choose a subject
                        </option>

                        {% for subject in subjects %}

                        <option
                            value="{{ subject }}"
                            {% if selectedSubject == subject %}
                            selected
                            {% endif %}
                        >
                            {{ subject }}
                        </option>

                        {% endfor %}

                    </select>

                </div>


                <div class="form-group">

                    <label for="question">
                        Your Question
                    </label>

                    <textarea
                        id="question"
                        name="question"
                        rows="6"
                        placeholder="Ask a question about your study material..."
                        required
                        onkeydown="if(event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); this.form.submit(); }"
                    >{{ question if question else "" }}</textarea>

                    <p class="input-help">
                        Press Enter to submit. Press Shift + Enter for a new line.
                    </p>

                </div>


                <button
                    type="submit"
                    class="primary-button"
                >
                    Ask StudySense
                </button>

            </form>

        </section>


        {% if selectedSubject %}

        <section class="selected-subject">

            <strong>
                Studying:
            </strong>

            {{ selectedSubject }}

        </section>

        {% endif %}


        {% if answer %}

        <section class="answer-box">

            <h2>
                StudySense
            </h2>

            <p>
                {{ answer }}
            </p>

        </section>

        {% endif %}


        <section class="tip-box">

            <h3>
                Try asking:
            </h3>

            <ul>

                <li>
                    What are the most important concepts?
                </li>

                <li>
                    Explain this topic in simple terms.
                </li>

                <li>
                    What is the difference between these concepts?
                </li>

                <li>
                    What should I memorize?
                </li>

            </ul>

        </section>

    </main>

</div>

</body>

</html>
